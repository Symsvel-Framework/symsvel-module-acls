{
    "name": "symsvel-framework/module-acls",
    "description": "SymSvel module Acls",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^8.1",
        "doctrine/orm": "^3.3",
        "doctrine/doctrine-bundle": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SymSvel\\Module\\Acls\\": "back/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymSvel\\Module\\Acls\\Tests\\": "back/tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "test": "phpunit -c back/phpunit.xml.dist --display-skipped",
        "qa": [
            "@test"
        ]
    },
    "extra": {
        "symsvel-module": {
            "manifest": "module.json"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev",
            "dev-dev": "1.0.x-dev"
        }
    }
}
